---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import IdeaRow from "../../components/IdeaRow.astro";

const ideas = await getCollection("ideas");
---

<BaseLayout title="Ideas" description="Raw concepts and experiments worth exploring.">
  <section class="container page-hero">
    <h1>Ideas</h1>
    <p>Raw concepts and experiments. Some may become projects; some are just worth keeping visible.</p>
  </section>
  <section class="container panel listing">
    <div class="row-list">
      {ideas.map((idea) => <IdeaRow idea={idea} />)}
    </div>
  </section>
</BaseLayout>
