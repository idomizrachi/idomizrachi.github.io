---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectRow from "../components/ProjectRow.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Tag from "../components/Tag.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => new Date(b.data.updated).valueOf() - new Date(a.data.updated).valueOf(),
);
const logs = (await getCollection("logs")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredProject = projects.find((project) => project.data.featured) ?? projects[0];
const stack = ["SwiftUI", "Kotlin", "Jetpack Compose", "Python", "Firebase", "Supabase", "Ollama", "Tailwind CSS"];
---

<BaseLayout>
  <section class="container hero">
    <div>
      <h1>Building, learning and shipping.</h1>
      <p>A personal dev lab for logs, projects, ideas and everything in between.</p>
      <div class="button-row">
        <a class="button primary" href="/logs/">Read Logs <span aria-hidden="true">→</span></a>
        <a class="button" href="/projects/">Explore Projects</a>
      </div>
    </div>

    {featuredProject && (
      <article class="panel featured">
        <div>
          <span class="eyebrow"><span class="dot"></span> Latest update</span>
          <h2>{featuredProject.data.title}</h2>
          <p>{featuredProject.data.description}</p>
          <a class="text-link" href={`/projects/${featuredProject.id}/`}>View project <span aria-hidden="true">→</span></a>
        </div>
        {featuredProject.data.image && <img src={featuredProject.data.image} alt="" loading="eager" />}
      </article>
    )}
  </section>

  <section class="container overview-grid" aria-label="Primary sections">
    <a class="panel overview-card" href="/logs/">
      <span class="tile-icon blue" aria-hidden="true">□</span>
      <h2>Logs</h2>
      <p>Learnings, technical notes and dev logs.</p>
      <span class="text-link">See all logs <span aria-hidden="true">→</span></span>
    </a>
    <a class="panel overview-card" href="/projects/">
      <span class="tile-icon" aria-hidden="true">◇</span>
      <h2>Projects</h2>
      <p>Things I am building and shipping.</p>
      <span class="text-link">See all projects <span aria-hidden="true">→</span></span>
    </a>
    <a class="panel overview-card" href="/ideas/">
      <span class="tile-icon amber" aria-hidden="true">◌</span>
      <h2>Ideas</h2>
      <p>Raw concepts and experiments worth exploring.</p>
      <span class="text-link">See all ideas <span aria-hidden="true">→</span></span>
    </a>
  </section>

  <section class="container panel section-panel">
    <SectionHeader title="Latest Logs" href="/logs/" />
    <div class="compact-list">
      {logs.slice(0, 5).map((log) => (
        <a class="compact-row" href={`/logs/${log.id}/`}>
          <span aria-hidden="true">▧</span>
          <span>{log.data.title}</span>
          <span class="date">{log.data.date.toLocaleDateString("en", { month: "short", day: "numeric" })}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container split-grid">
    <div class="panel">
      <SectionHeader title="Latest Projects" href="/projects/" />
      <div class="row-list">
        {projects.slice(0, 4).map((project) => <ProjectRow project={project} />)}
      </div>
    </div>

    <div class="panel">
      <SectionHeader title="About / Stack" href="/about/" action="More about me" />
      <div class="stack-copy">
        <p>I build apps, tools and games. Interested in AI, mobile, running and thoughtful product design.</p>
        <div class="tag-list">
          {stack.map((tag) => <Tag label={tag} />)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
