---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "about");
if (!page) {
  throw new Error("Missing about page content.");
}
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="content-container article">
    <header class="article-header">
      <h1>{page.data.title}</h1>
      {page.data.description && <p>{page.data.description}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
